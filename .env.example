# Select gemini or openai. Choose a model available to your account.
EVE_PROVIDER=gemini
EVE_MODEL=gemini-2.5-flash
EVE_API_KEY=replace-with-your-api-key
EVE_DATA_DIR=data
EVE_STORAGE_DIR=storage
EVE_BOT_CONFIG=bot.yaml
# Defaults to local embeddings; first use downloads the model.
EVE_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
