{
  "name": "eve-ah demos",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000, 8001],
  "portsAttributes": {
    "8000": { "label": "Amaze-on", "onAutoForward": "notify" },
    "8001": { "label": "Hammered University", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/codespaces.md"]
    }
  }
}
